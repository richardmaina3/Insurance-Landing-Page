---
import { testimonials } from '../content/testimonials';
---

<section id="testimonials" class="mx-auto max-w-6xl px-8 py-24">
  <h2 class="text-3xl md:text-4xl">What clients say</h2>

  <div class="mt-11 grid gap-7 md:grid-cols-2">
    {
      testimonials.map((testimonial) => (
        <div class="flex flex-col gap-4 rounded-xl border border-line bg-white p-9">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-mint font-display text-lg font-bold text-mint-ink">
            "
          </div>
          <p class="leading-relaxed">"{testimonial.quote}"</p>
          <div class="text-sm font-semibold text-ink-soft">{testimonial.attribution}</div>
        </div>
      ))
    }
  </div>
</section>
