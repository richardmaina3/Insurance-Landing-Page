---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const advisorName = '[Your Name]';
---

<BaseLayout
  title={`${advisorName} — International Health Insurance Advisor`}
  description="Independent advice on corporate and personal international health insurance plans."
>
  <Nav name={advisorName} />
  <main>
    <Hero name={advisorName} />
    <Services />
    <About name={advisorName} />
    <Testimonials />
    <Contact />
  </main>
  <Footer name={advisorName} />
</BaseLayout>
